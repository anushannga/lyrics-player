[
  {
    "id": 0,
    "section": "section1",
    "section_line": 0,
    "language": "si",
    "text": "ඩබල් එකේ අප් කර ගත්තම ලෙවල්",
    "alignment_text": "dabal eke ap kara gaththama lewal"
  },
  {
    "id": 1,
    "section": "section1",
    "section_line": 1,
    "language": "si",
    "text": "එකෙන් අත්පත් කරගත්තා ඕන දේවල්",
    "alignment_text": "eken athpath karagaththaa ona dewal"
  },
  {
    "id": 2,
    "section": "section1",
    "section_line": 2,
    "language": "si",
    "text": "වචනෙන් කන් තැන්පත් කරනවා",
    "alignment_text": "wachanen kan thaenpath karanawaa"
  },
  {
    "id": 3,
    "section": "section1",
    "section_line": 3,
    "language": "si",
    "text": "මේ මං රැපෙන් මං මන්මත් කරන ගෙවල්",
    "alignment_text": "me mang raepen mang manmath karana gewal"
  },
  {
    "id": 4,
    "section": "section2",
    "section_line": 0,
    "language": "si",
    "text": "එපා වෙන්න ළිඳේ ඉඳලාම",
    "alignment_text": "epaa wenna linde indalaama"
  },
  {
    "id": 5,
    "section": "section2",
    "section_line": 1,
    "language": "si",
    "text": "පල් වෙන මැඩියෙක්",
    "alignment_text": "pal wena maediyek"
  },
  {
    "id": 6,
    "section": "section2",
    "section_line": 2,
    "language": "si",
    "text": "සෙල්ලමටයි දුන්නේ කල් වෙලා වැඩියෙන්",
    "alignment_text": "sellamatayi dunne kal welaa waediyen"
  },
  {
    "id": 7,
    "section": "section2",
    "section_line": 3,
    "language": "si",
    "text": "පත්තියන් උනේ තැම්බිලා හැලියෙන්",
    "alignment_text": "paththiyan une thaembilaa haeliyen"
  },
  {
    "id": 8,
    "section": "section3",
    "section_line": 0,
    "language": "si",
    "text": "හැංගිලා බලයි උන් මං දිහා වැඩියෙන්",
    "alignment_text": "haenggilaa balayi un mang dihaa waediyen"
  },
  {
    "id": 9,
    "section": "section3",
    "section_line": 1,
    "language": "si",
    "text": "ගැම්මෙන් අහනවා සද්දෙ දාන්",
    "alignment_text": "gaemmen ahanawaa sadde daan"
  },
  {
    "id": 10,
    "section": "section3",
    "section_line": 2,
    "language": "si",
    "text": "සැලකිල්ල නමට යන පැත්තේ බං",
    "alignment_text": "saelakilla namata yana paeththe bang"
  },
  {
    "id": 11,
    "section": "section3",
    "section_line": 3,
    "language": "si",
    "text": "කාගේ කන කද නැත්තෙ මං",
    "alignment_text": "kaage kana kada naeththe mang"
  },
  {
    "id": 12,
    "section": "section4",
    "section_line": 0,
    "language": "si",
    "text": "අද බර ගෝස්තියක මැද්දේ මං",
    "alignment_text": "ada bara gosthiyaka maedde mang"
  },
  {
    "id": 13,
    "section": "section4",
    "section_line": 1,
    "language": "si",
    "text": "අකුරු වලින් සී සාන්නේ",
    "alignment_text": "akuru walin see saanne"
  },
  {
    "id": 14,
    "section": "section4",
    "section_line": 2,
    "language": "si",
    "text": "ඒකයි හැම කන්නෙම ගී දාන්නේ",
    "alignment_text": "ekayi haema kannema gee daanne"
  },
  {
    "id": 15,
    "section": "section4",
    "section_line": 3,
    "language": "si",
    "text": "බලයි කවුද මේ භාණ්ඩේ",
