  },
  {
    "id": 16,
    "section": "section5",
    "section_line": 0,
    "language": "si",
    "text": "මේ කට හැදුනේ පරණ ශ්‍රීකාණ්ඩේ",
    "alignment_text": "me kata haedune parana shreekaande"
  },
  {
    "id": 17,
    "section": "section5",
    "section_line": 1,
    "language": "si",
    "text": "හැදුණ් නෑ ගෙදරට බරක් වෙලා",
    "alignment_text": "haedun nae gedarata barak welaa"
  },
  {
    "id": 18,
    "section": "section5",
    "section_line": 2,
    "language": "si",
    "text": "කෙට්ටුයි පොළොවටවත් නෑ බරක් වෙලා",
    "alignment_text": "kettuyi polowatawath nae barak welaa"
  },
  {
    "id": 19,
    "section": "section5",
    "section_line": 3,
    "language": "si",
    "text": "හැදුවත් කතා සමහරක් දෙනා",
    "alignment_text": "haeduwath kathaa samaharak denaa"
  },
  {
    "id": 20,
    "section": "section6",
    "section_line": 0,
    "language": "si",
    "text": "කමක් නෑ පිස්සොත් ලොකු වෙනව හරක් වෙලා",
    "alignment_text": "kamak nae pissoth loku wenawa harak welaa"
  },
  {
    "id": 21,
    "section": "section6",
    "section_line": 1,
    "language": "si",
    "text": "බොරුවෙන් ඉන්නෙ නෑ රවට්ටාං",
    "alignment_text": "boruwen inne nae rawattaang"
  },
  {
    "id": 22,
    "section": "section6",
    "section_line": 2,
    "language": "si",
    "text": "මං මගේ ඇත්ත චරිතේ යන්නේ පවත්වාන්",
    "alignment_text": "mang mage aeththa charithe yanne pawathwaan"
  },
  {
    "id": 23,
    "section": "section6",
    "section_line": 3,
    "language": "si",
    "text": "පසු බහින්නෙ නෑ තවත් නම්",
    "alignment_text": "pasu bahinne nae thawath nam"
  },
  {
    "id": 24,
    "section": "section7",
    "section_line": 0,
    "language": "si",
    "text": "බලමු පුළුවන් එකෙක් ඇවිල්ල නවත්තහං මාව",
